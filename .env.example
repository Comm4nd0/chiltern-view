# Copy to .env and edit before deploying on Luma001.

# --- Django ---
DJANGO_SECRET_KEY=please-generate-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated hostnames/IPs the API will serve (e.g. luma001,luma001.local,192.168.1.50)
DJANGO_ALLOWED_HOSTS=luma001,localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/London

# --- Database (Postgres in Docker) ---
POSTGRES_DB=chiltern_view
POSTGRES_USER=chiltern
POSTGRES_PASSWORD=change-me

# --- Networking ---
BACKEND_PORT=8000
# Port the React web app (nginx) is served on (host side).
WEB_PORT=8080
# For Flutter web in production, list its origin(s) instead of allowing all:
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Optional admin bootstrap (created on first container start) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Web push reminders (browser notifications) ---
# Generate once with: npx web-push generate-vapid-keys
# Leave empty to disable browser reminders (the phone app is unaffected).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com
# Local hour (Europe/London) after which the daily reminder push goes out.
PUSH_REMINDER_HOUR=8

# --- Weather (optional overrides; defaults are Medmenham) ---
# WEATHER_LATITUDE=51.557
# WEATHER_LONGITUDE=-0.812
# WEATHER_LOCATION_NAME=Medmenham, Buckinghamshire
# WEATHER_CACHE_MINUTES=30
# WATERING_RAIN_THRESHOLD_MM=5
# FROST_TEMP_C=2

# The app now requires a login. After the stack is up, create each person's
# account in Django admin (/admin/) and link it to their Person record — see the
# "Authentication" section of the README. Tokens live in the DB; no extra secret
# is needed here.
