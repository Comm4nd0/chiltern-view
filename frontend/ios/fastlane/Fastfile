default_platform(:ios)

# frontend/ (the Flutter project root) is two levels up from this file.
FLUTTER_ROOT = File.expand_path("../..", __dir__)

platform :ios do
  desc "Build with Flutter and upload a new build to TestFlight"
  lane :beta do
    # Authenticate with an App Store Connect API key (no Apple-ID 2FA prompts).
    # Set these env vars first (see docs/IOS_TESTFLIGHT.md):
    #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the AuthKey_XXXX.p8)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # Flutter drives the Xcode archive + export, using the signing configured in
    # Xcode (do the first build/upload from Xcode once to set signing up).
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter", "build", "ipa", "--release", "--export-method", "app-store")
    end

    ipa = Dir[File.join(FLUTTER_ROOT, "build/ios/ipa/*.ipa")].max_by { |f| File.mtime(f) }
    UI.user_error!("No .ipa found in frontend/build/ios/ipa/ — check the Flutter build output.") unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end
end
